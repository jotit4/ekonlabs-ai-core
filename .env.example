# Supabase — requeridas en build time (NEXT_PUBLIC_*) y runtime
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role — SERVER ONLY, NUNCA en cliente browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# FastAPI backend (ekonlabs-ai-core en EasyPanel)
FASTAPI_API_KEY=your-fastapi-api-key-here
FASTAPI_BASE_URL=http://ekonlabs-ai-agente-ia:8000

# Chatwoot
CHATWOOT_ACCESS_TOKEN=your-chatwoot-token-here
CHATWOOT_BASE_URL=https://your-chatwoot-instance.com
CHATWOOT_ACCOUNT_ID=your-account-id
