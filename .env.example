# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://<project>.supabase.co
# Must be the service_role key (not anon key)
SUPABASE_KEY=<service-role-key>
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Meta / WhatsApp API
# -----------------------------------------------------------------------------
META_VERIFY_TOKEN=<webhook-verify-token>
META_APP_SECRET=<meta-app-secret>
# Permanent access token for sending messages via Meta Cloud API
META_ACCESS_TOKEN=<meta-access-token>

# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------
OPENAI_API_KEY=<openai-api-key>

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# Secret key for admin API endpoints (POST /api/v1/tenants, PATCH /api/v1/tenants/{id}/rules)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=<generate-a-strong-random-secret>

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Requests per minute per tenant (applied on tenant-scoped routes)
RATE_LIMIT_REQUESTS_PER_MINUTE=30
# Infrastructure-level burst protection per IP (global ceiling)
RATE_LIMIT_BURST=50

# -----------------------------------------------------------------------------
# Google Calendar API (Epic 3)
# -----------------------------------------------------------------------------
# Path to the service account JSON file (relative to project root)
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials/google-calendar.json

# -----------------------------------------------------------------------------
# Scheduling
# -----------------------------------------------------------------------------
# Duration of each appointment slot in minutes
DEFAULT_SLOT_DURATION_MINUTES=60
# How many hours ahead to search for available slots
SCHEDULING_LOOKAHEAD_HOURS=72

# -----------------------------------------------------------------------------
# WhatsApp Provider
# -----------------------------------------------------------------------------
# Selects the WhatsApp integration layer. Default: meta
WHATSAPP_PROVIDER=meta   # "meta" | "evolution"

# -----------------------------------------------------------------------------
# Evolution API (required only when WHATSAPP_PROVIDER=evolution)
# -----------------------------------------------------------------------------
EVOLUTION_API_URL=https://your-evolution-server.example.com
EVOLUTION_API_KEY=<your-evolution-api-key>
EVOLUTION_INSTANCE=clinic-instance-name
# Clinic's WhatsApp number used for tenant resolution (no "+" prefix)
EVOLUTION_DISPLAY_PHONE=5491112345678
